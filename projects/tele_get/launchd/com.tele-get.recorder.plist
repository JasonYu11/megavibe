<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN"
  "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>com.tele-get.recorder</string>

  <key>ProgramArguments</key>
  <array>
    <string>/bin/bash</string>
    <string>/Users/macbot/Documents/tele_get/scripts/run_service.sh</string>
  </array>

  <key>WorkingDirectory</key>
  <string>/Users/macbot/Documents/tele_get</string>

  <key>RunAtLoad</key>
  <true/>

  <key>KeepAlive</key>
  <true/>

  <key>StandardOutPath</key>
  <string>/Users/macbot/Documents/tele_get/logs/launchd.out.log</string>

  <key>StandardErrorPath</key>
  <string>/Users/macbot/Documents/tele_get/logs/launchd.err.log</string>
</dict>
</plist>

