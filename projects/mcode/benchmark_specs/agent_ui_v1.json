    {
      "id": "D1_bug_fix_python",
      "tier": "p0",
      "category": "engineering",
      "product_requirement": "Bug 修复",
      "setup_files": {
        "buggy_average.py": "import json\n\n\ndef average(values):\n    return sum(values) / len(values) + 1\n\n\nresult = {\"average\": average([2, 4, 6])}\nPath = __import__('pathlib').Path\nPath('bug_result.json').write_text(json.dumps(result), encoding='utf-8')\nprint(result)\n"
      },
      "prompt": "运行 buggy_average.py 复现问题，修复 average([2,4,6]) 应该等于 4 的 bug，再运行验证。必须使用 python_run 运行脚本，修改文件用 edit_file，最后简短说明验证结果。",
      "checks": {
        "final_answer_required": true,
        "required_tools": ["python_run", "edit_file"],
        "forbidden_tools": ["bash"],
        "result_file": "bug_result.json",
        "result_equals": {
          "average": 4
        },
        "file_not_contains": {
          "buggy_average.py": ["+ 1"]
        },
        "required_change_sources": ["edit_file"],
        "ui_turn_answer_leaked": false
      }
    },
    {
