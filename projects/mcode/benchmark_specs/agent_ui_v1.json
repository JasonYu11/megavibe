{
  "name": "agent_ui_v1",
  "description": "Mcode product-level agent + UI benchmark suite",
  "required_case_count": 13,
  "cases": [
    {
      "id": "A1_plain_conversation",
      "tier": "p0",
      "category": "basic",
      "product_requirement": "普通对话",
      "prompt": "你是什么模型，只用一句话回答。不要调用工具。",
      "checks": {
        "final_answer_required": true,
        "max_tool_calls": 0,
        "answer_max_lines": 3,
        "answer_forbidden_patterns": ["📋", "完整工作回顾", "\\*\\*1\\."],
        "ui_turn_answer_leaked": false
      }
    },
    {
      "id": "A2_read_readme_summary",
      "tier": "p0",
      "category": "file_read",
      "product_requirement": "读文件",
      "setup_files": {
        "README.md": "# Mcode Benchmark\n\n- 支持项目会话。\n- 支持工具调用。\n- 支持文件审核。\n"
      },
      "prompt": "读取 README.md 并总结 3 点。必须使用 read_file。最终回答不超过 8 行。",
      "checks": {
        "final_answer_required": true,
        "required_tools": ["read_file"],
        "answer_max_lines": 8,
        "ui_turn_answer_leaked": false
      }
    },
    {
      "id": "B0_python_script_run",
      "tier": "p0",
      "category": "python",
      "product_requirement": "创建并运行 Python 脚本",
      "prompt": "创建 calc_square.py，计算 7 的平方并把 {\"square\": 49} 写入 calc_result.json。必须使用 write_file 创建脚本，并使用 python_run 运行验证。最后简短说明结果。",
      "checks": {
        "final_answer_required": true,
        "required_tools": ["write_file", "python_run"],
        "forbidden_tools": ["bash"],
        "required_files": ["calc_square.py"],
        "result_file": "calc_result.json",
        "result_equals": {
          "square": 49
        },
        "required_events": ["preview", "checkpoint_saved", "workspace_changes_detected"],
        "required_change_sources": ["write_file", "python_run"],
        "ui_turn_answer_leaked": false
      }
    },
    {
      "id": "B1_write_file_review",
      "tier": "p0",
